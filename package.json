{
  "name": "fika-editor",
  "version": "3.0.0",
  "description": "Fika presentation editor embed bundle with a typed agentic bridge.",
  "type": "module",
  "main": "dist/embed/fika-embed.js",
  "module": "dist/embed/fika-embed.js",
  "types": "dist/types/embed/index.d.ts",
  "files": [
    "dist/embed",
    "dist/types",
    "docs/EMBED.md",
    "docs/AGENTIC_BRIDGE.md",
    "docs/RELEASE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/embed/index.d.ts",
      "import": "./dist/embed/fika-embed.js",
      "default": "./dist/embed/fika-embed.js"
    },
    "./embed": {
      "types": "./dist/types/embed/index.d.ts",
      "import": "./dist/embed/fika-embed.js",
      "default": "./dist/embed/fika-embed.js"
    },
    "./embed.css": {
      "import": "./dist/embed/fika-embed.css",
      "default": "./dist/embed/fika-embed.css"
    },
    "./agentic-manifest.json": "./dist/embed/agentic-manifest.json",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css",
    "dist/embed/fika-embed.css"
  ],
  "scripts": {
    "dev": "rsbuild dev",
    "doctor": "react-doctor --no-telemetry",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:embed": "node scripts/run-i18n.mjs --no-watch && npm run build:types && rsbuild build --config rsbuild.config.embed.ts && node scripts/scope-embed-css.mjs && node scripts/extract-embed-fonts.mjs && node scripts/copy-embed-public.mjs && node scripts/generate-agentic-manifest.mjs",
    "agentic:manifest": "node scripts/generate-agentic-manifest.mjs",
    "build:types": "node -e \"require('node:fs').rmSync('dist/types',{recursive:true,force:true})\" && tsc -p tsconfig.types.json && node scripts/rewrite-embed-types.mjs",
    "preview": "rsbuild preview",
    "build-only": "rsbuild build",
    "type-check": "tsc -p tsconfig.app.json --noEmit --pretty false",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "test:react-mount": "node scripts/check-react-mount.mjs",
    "i18n": "node scripts/run-i18n.mjs",
    "i18n:build": "node scripts/run-i18n.mjs --no-watch",
    "test:agentic-bridge": "node scripts/check-agentic-bridge.mjs && node scripts/check-composition.mjs && node scripts/check-layout-robustness.mjs && node scripts/check-agent-text.mjs && node scripts/check-canvas-pointer.mjs && node scripts/check-canvas-zoom.mjs && node scripts/check-canvas-hit-test.mjs && node scripts/check-editor-caret.mjs && node scripts/check-text-selection.mjs && node scripts/check-import-apply.mjs && node scripts/check-job-progress.mjs && node scripts/check-element-order.mjs && node scripts/check-react-mount.mjs && node scripts/check-fn-utils.mjs && node scripts/check-snap.mjs",
    "test:omml-export": "node scripts/e2e-math-export/omml-export.mjs",
    "test:port-features": "node scripts/check-pptx-unit.mjs && node scripts/check-pptx-import-picture.mjs && node scripts/check-pptx-import-text.mjs && node scripts/check-pptx-text-fit.mjs && node scripts/check-text-fit-scale.mjs && node scripts/check-hyperlink-follow.mjs && node scripts/check-slide-code-utils.mjs && node scripts/check-latex-extract.mjs && node scripts/check-theme-file.mjs && node scripts/check-port-features.mjs && node scripts/check-code-highlight.mjs && node scripts/check-pptx-import-fidelity.mjs && node scripts/check-import-math-scrollbars.mjs && node scripts/check-text-contrast.mjs && node scripts/check-omml-run-style.mjs && node scripts/check-pptx-import-fonts.mjs",
    "test:text-fit": "node scripts/check-text-fit-scale.mjs",
    "test:text-fit:e2e": "node scripts/e2e-text-fit.mjs",
    "test:import-fidelity": "node scripts/check-pptx-import-fidelity.mjs",
    "test:import-fidelity:e2e": "bunx tsx --tsconfig tsconfig.app.json scripts/e2e-pptx-import-fidelity.mts",
    "test:import-fidelity:all": "bun run test:import-fidelity && bun run test:import-fidelity:e2e",
    "test:sb1-import": "node scripts/check-sb1-import.mjs",
    "test:sb1-import:e2e": "node scripts/e2e-sb1-import.mjs",
    "test:houby-import": "node scripts/check-pptx-import-fonts.mjs",
    "test:houby-import:e2e": "node scripts/e2e-pptx-import-houby.mjs"
  },
  "author": "Matěj \"lofcz\" Štágl",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lofcz/fika.git"
  },
  "bugs": {
    "url": "https://github.com/lofcz/fika/issues"
  },
  "homepage": "https://github.com/lofcz/fika#readme",
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lofcz/pptxgenjs": "^4.1.16",
    "animate.css": "^4.1.1",
    "buffer": "^6.0.3",
    "clipboard": "^2.0.11",
    "codemirror": "^6.0.2",
    "crypto-js": "^4.2.0",
    "dexie": "^4.4.4",
    "dompurify": "^3.4.13",
    "echarts": "^6.1.0",
    "events": "^3.3.0",
    "fast-average-color": "^9.5.2",
    "file-saver": "^2.0.5",
    "hfmath": "^0.0.2",
    "html-to-image": "^1.11.13",
    "immer": "^11.1.16",
    "jszip": "^3.10.1",
    "lucide-react": "^1.31.0",
    "markdown-it": "^15.0.0",
    "markdown-it-texmath": "^1.0.0",
    "mathlive": "npm:@lofcz/mathlive@^0.110.2",
    "mathml2omml": "^0.5.0",
    "mermaid": "^11.16.1",
    "mitt": "^3.0.1",
    "nanoid": "^6.0.1",
    "number-precision": "^1.6.0",
    "overlayscrollbars": "^2.16.0",
    "perfect-freehand": "^1.2.3",
    "pptxtojson": "npm:@lofcz/pptxtojson@^2.2.5",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.3",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.2",
    "shiki": "^4.4.3",
    "svg-pathdata": "^9.0.0",
    "tinycolor2": "^1.6.0",
    "tippy.js": "^6.3.7",
    "txml": "^6.0.0",
    "use-sync-external-store": "^1.6.0",
    "wawoff2": "^2.0.1",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "react": ">19.2.0",
    "react-dom": ">19.2.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.1.0",
    "@rsbuild/plugin-node-polyfill": "^1.4.3",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rsbuild/plugin-sass": "^2.0.1",
    "@rushstack/eslint-patch": "^1.16.1",
    "@types/crypto-js": "^4.2.1",
    "@types/dompurify": "^3.2.0",
    "@types/file-saver": "^2.0.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/tinycolor2": "^1.4.6",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "npm-run-all2": "^9.0.3",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "postcss-selector-parser": "^7.1.5",
    "react": "^19.2.8",
    "react-doctor": "^0.9.12",
    "react-dom": "^19.2.8",
    "react-scan": "^0.5.7",
    "sass": "^1.100.0",
    "typesafe-i18n": "npm:@lofcz/typesafe-i18n@5.27.4",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true
  }
}
