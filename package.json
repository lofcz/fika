{
  "name": "fika-editor",
  "version": "3.0.26",
  "description": "Fika presentation editor embed bundle with a typed agentic bridge.",
  "type": "module",
  "main": "dist/embed/fika-embed.js",
  "module": "dist/embed/fika-embed.js",
  "types": "dist/types/embed/index.d.ts",
  "files": [
    "dist/embed",
    "dist/types",
    "docs/EMBED.md",
    "docs/AGENTIC_BRIDGE.md",
    "docs/RELEASE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/embed/index.d.ts",
      "import": "./dist/embed/fika-embed.js",
      "default": "./dist/embed/fika-embed.js"
    },
    "./embed": {
      "types": "./dist/types/embed/index.d.ts",
      "import": "./dist/embed/fika-embed.js",
      "default": "./dist/embed/fika-embed.js"
    },
    "./embed.css": {
      "import": "./dist/embed/fika-embed.css",
      "default": "./dist/embed/fika-embed.css"
    },
    "./agentic-manifest.json": "./dist/embed/agentic-manifest.json",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": [
    "*.css",
    "dist/embed/fika-embed.css"
  ],
  "scripts": {
    "dev": "rsbuild dev",
    "dx": "1dxway start",
    "dx:install": "bunx 1dxway",
    "dx:start": "1dxway start",
    "doctor": "react-doctor --no-telemetry",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:embed": "node scripts/run-i18n.mjs --no-watch && npm run build:types && rsbuild build --config rsbuild.config.embed.ts && node scripts/rewrite-embed-base-uri.mjs && node scripts/merge-embed-css.mjs && node scripts/scope-embed-css.mjs && node scripts/extract-embed-fonts.mjs && node scripts/copy-embed-public.mjs && node scripts/generate-agentic-manifest.mjs",
    "agentic:manifest": "node scripts/generate-agentic-manifest.mjs",
    "build:types": "node -e \"require('node:fs').rmSync('dist/types',{recursive:true,force:true})\" && tsc -p tsconfig.types.json && node scripts/rewrite-embed-types.mjs",
    "prepack": "node scripts/verify-embed-pack.mjs",
    "prepublishOnly": "npm run build:embed && node scripts/verify-embed-pack.mjs --tarball",
    "pack:verify": "node scripts/verify-embed-pack.mjs --tarball",
    "preview": "rsbuild preview",
    "build-only": "rsbuild build",
    "type-check": "tsc -p tsconfig.app.json --noEmit --pretty false",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "node scripts/test.mjs",
    "i18n": "node scripts/run-i18n.mjs",
    "i18n:build": "node scripts/run-i18n.mjs --no-watch"
  },
  "author": "Matěj \"lofcz\" Štágl",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lofcz/fika.git"
  },
  "bugs": {
    "url": "https://github.com/lofcz/fika/issues"
  },
  "homepage": "https://github.com/lofcz/fika#readme",
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@karibash/pixel-units": "^2.3.0",
    "@tanstack/react-virtual": "^3.14.10",
    "@use-gesture/react": "^10.3.1",
    "@use-gesture/vanilla": "^10.3.1",
    "animate.css": "^4.1.1",
    "buffer": "^6.0.3",
    "clipboard": "^2.0.11",
    "codemirror": "^6.0.2",
    "crypto-js": "^4.2.0",
    "dexie": "^4.4.4",
    "dompurify": "^3.4.14",
    "echarts": "^6.1.0",
    "entities": "^8.0.0",
    "events": "^3.3.0",
    "fast-average-color": "^9.5.2",
    "fast-equals": "^6.0.2",
    "file-saver": "^2.0.5",
    "flatbush": "^4.6.2",
    "hfmath": "^0.0.2",
    "html-to-image": "^1.11.13",
    "immer": "^11.1.18",
    "jszip": "^3.10.1",
    "lucide-react": "^1.33.0",
    "markdown-it": "^15.0.0",
    "markdown-it-texmath": "^1.0.0",
    "mathlive": "npm:@lofcz/mathlive@^0.110.6",
    "mathml2omml-plus": "^0.6.4",
    "mermaid": "^11.17.0",
    "mitt": "^3.0.1",
    "nanoid": "^6.0.1",
    "number-precision": "^1.6.0",
    "overlayscrollbars": "^2.16.0",
    "parse5": "^8.0.1",
    "perfect-freehand": "^1.2.3",
    "pptxgenjs-plus": "^4.2.1",
    "pptxtojson": "npm:@lofcz/pptxtojson@^2.2.9",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.3",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.2",
    "rbush": "^4.0.1",
    "react-resizable-panels": "^4.12.3",
    "render-tag": "^0.1.29",
    "shiki": "^4.4.3",
    "style-to-object": "^2.0.2",
    "svg-pathdata": "^9.0.0",
    "tinycolor2": "^1.6.0",
    "tippy.js": "^6.3.7",
    "txml": "^6.0.0",
    "use-sync-external-store": "^1.6.0",
    "woff-lib": "^0.0.3",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "react": ">19.2.0",
    "react-dom": ">19.2.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.1.0",
    "@rsbuild/plugin-node-polyfill": "^1.4.3",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rsbuild/plugin-sass": "^2.0.1",
    "@rstest/core": "^0.11.8",
    "@types/crypto-js": "^4.2.1",
    "@types/dompurify": "^3.2.0",
    "@types/file-saver": "^2.0.7",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.2.0",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/tinycolor2": "^1.4.6",
    "1dxway": "^0.1.24",
    "ink": "^7.1.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "postcss-selector-parser": "^7.1.5",
    "react": "^19.2.8",
    "react-doctor": "^0.9.12",
    "react-dom": "^19.2.8",
    "react-scan": "^0.5.7",
    "sass": "^1.103.0",
    "typesafe-i18n": "npm:@lofcz/typesafe-i18n@5.27.4",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true
  }
}
